# Default: complete deterministic review, no network and no AI account required.
AICR_PROVIDER=openai-compatible
AICR_BASE_URL=https://integrate.api.nvidia.com/v1
AICR_MODEL=meta/llama-3.1-70b-instruct
AICR_API_KEY=

# Optional: use an already installed local Ollama model.
# AICR_PROVIDER=ollama
# AICR_MODEL=your-installed-local-model
# OpenAI-compatible LOCAL server: provider=openai-compatible, base URL includes /v1.
# Other remote endpoints and Ollama :cloud model names are rejected.
# Optional: NVIDIA free hosted endpoint (https://build.nvidia.com). Your code is sent to NVIDIA.
# AICR_PROVIDER=openai-compatible
# AICR_BASE_URL=https://integrate.api.nvidia.com/v1
# AICR_MODEL=meta/llama-3.1-70b-instruct
# AICR_API_KEY=nvapi-...
AICR_TIMEOUT_SECONDS=60
AICR_MAX_FILE_BYTES=500000
AICR_MAX_FILES=1000
AICR_MAX_TOTAL_BYTES=20000000
AICR_MAX_AI_CHARS=24000
AICR_MAX_AI_CALLS=8

# API server-only settings. Export these in the shell that starts aicr-api.
AICR_WEB_DATA_DIR=.aicr/web
AICR_WEB_PORT=8000
AICR_WEB_SOURCE_RETENTION_HOURS=24
AICR_WEB_MAX_FILES=100
AICR_WEB_MAX_SOURCE_BYTES=2000000
AICR_WEB_GITHUB_MAX_FILES=30
# Optional personal access token. Never use a NEXT_PUBLIC_ prefix for secrets.
AICR_WEB_GITHUB_TOKEN=
